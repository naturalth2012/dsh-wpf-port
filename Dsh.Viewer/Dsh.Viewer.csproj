<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Dsh.App\Dsh.App.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="ZstdNet" Version="1.5.7" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>Dsh.Viewer</RootNamespace>
    <AssemblyName>Dsh.Viewer</AssemblyName>
    <!-- Application icon: multi-resolution .ico compiled into the .exe (Explorer + taskbar). -->
    <ApplicationIcon>Assets\app-icon.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- The window/taskbar PNG icon as a WPF resource (available via pack URI). -->
  <ItemGroup>
    <Resource Include="Assets\app-icon.png" />
  </ItemGroup>

</Project>
