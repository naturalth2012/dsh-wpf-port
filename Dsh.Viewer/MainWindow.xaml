<Window x:Class="Dsh.Viewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:Dsh.App;assembly=Dsh.App"
        xmlns:local="clr-namespace:Dsh.Viewer"
        xmlns:loc="clr-namespace:Dsh.Viewer"
        Title="{loc:Loc Viewer.Title}"
        Icon="pack://application:,,,/Assets/app-icon.png"
        Height="720" Width="1080"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左：按工作区分组的会话树（L2：cwd → sessionId，路径段已解码） -->
        <DockPanel Grid.Column="0" Margin="0,0,10,0">
            <Button DockPanel.Dock="Top" Content="{loc:Loc OpenFolder}" Click="OpenFolder_Click" Margin="0,0,0,8"/>
            <TextBlock DockPanel.Dock="Top" Text="{Binding FolderPath, Mode=OneWay}" FontSize="11"
                       Foreground="Gray" TextTrimming="CharacterEllipsis" Margin="0,0,0,6"/>
            <TreeView ItemsSource="{Binding Workspaces}" SelectedItemChanged="OnTreeSelectionChanged">
                <TreeView.Resources>
                    <!-- 工作区节点：文件夹图标 + 解码后的 cwd 标签 -->
                    <HierarchicalDataTemplate DataType="{x:Type local:WorkspaceNode}"
                                              ItemsSource="{Binding Sessions}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📁" Margin="0,0,4,0"/>
                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold"/>
                        </StackPanel>
                    </HierarchicalDataTemplate>
                    <!-- 会话节点：气泡图标 + 会话标题/短 id（zstd 经角标标注） -->
                    <DataTemplate DataType="{x:Type local:SessionNode}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💬" Margin="0,0,4,0"/>
                            <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" MaxWidth="200"/>
                            <TextBlock Text=" zstd" FontSize="9" Foreground="#999" VerticalAlignment="Center"
                                       Visibility="{Binding IsZstd, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </DataTemplate>
                </TreeView.Resources>
            </TreeView>
        </DockPanel>

        <!-- 右：会话富 Surface 视图（L3）+ 逐条 Raw 详情 -->
        <DockPanel Grid.Column="1">
            <!-- 顶部工具栏：左侧会话标题（占满剩余空间）+ 右侧搜索/导出/语言（固定宽度）。
                 用 Grid 替代 DockPanel 避免控件互相挤压 / TextBox 被裁掉。 -->
            <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" FontWeight="Bold" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" MaxWidth="600"
                           Text="{Binding HeaderLine, Mode=OneWay}"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="MatchLabel" VerticalAlignment="Center" FontSize="11" Foreground="Gray"
                               Margin="0,0,6,0" Visibility="Collapsed"
                               Text="{Binding MatchText, Mode=OneWay}"/>
                    <TextBox Width="180" Height="22" VerticalContentAlignment="Center" Margin="6,0,0,0"
                             ToolTip="{loc:Loc Viewer.SearchTooltip}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Content="{loc:Loc Viewer.Export}" Margin="6,0,0,0" Padding="6,2"
                            Click="ExportButton_Click">
                        <Button.ContextMenu>
                            <ContextMenu Placement="Bottom">
                                <MenuItem Header="{loc:Loc Viewer.ExportMarkdown}" Click="ExportMarkdown_Click"/>
                                <MenuItem Header="{loc:Loc Viewer.ExportJsonl}" Click="ExportRawJsonl_Click"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <ComboBox Margin="6,0,0,0" MinWidth="100" Height="22" VerticalContentAlignment="Center"
                              ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage}"
                              ToolTip="{loc:Loc Viewer.Language}"/>
                </StackPanel>
            </Grid>

            <!-- 统计条（S4b）：基于折叠结果 + Trajectory 的轻量汇总 -->
            <Border DockPanel.Dock="Top" Background="#F8F9FA" BorderBrush="#E0E0E0"
                    BorderThickness="0,0,0,1" Padding="4,2,4,3" Margin="0,0,0,6">
                <TextBlock FontSize="11" Foreground="#5F6368" Text="{Binding StatsLine, Mode=OneWay}"/>
            </Border>

            <!-- Raw 详情面板：选中消息时显示其结构化字段（先 dock 到底部） -->
            <Expander x:Name="RawExpander" DockPanel.Dock="Bottom" Header="{loc:Loc Viewer.Raw}"
                      IsExpanded="False" Margin="0,6,0,0">
                <Border Background="#FAFBFC" BorderBrush="#E0E0E0" BorderThickness="1"
                        Padding="6" CornerRadius="4">
                    <TextBox x:Name="RawBox" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                             TextWrapping="Wrap" MaxHeight="220" VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"/>
                </Border>
            </Expander>

            <!-- 富消息流（Markdown + 工具卡 + reasoning 折叠），填满剩余高度 -->
            <ListBox x:Name="SurfaceList" ItemsSource="{Binding SurfaceView}"
                     SelectedItem="{Binding SelectedSurface}"
                     SelectionChanged="SurfaceList_SelectionChanged"
                     ScrollViewer.CanContentScroll="True"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,1"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <local:MessageRowControl Row="{Binding Row}"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </Grid>
</Window>
