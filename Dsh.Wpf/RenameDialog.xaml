<Window x:Class="Dsh.Wpf.RenameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="重命名会话" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource Surface1}" Foreground="{DynamicResource TextPrimary}">
    <StackPanel Margin="16" Width="320">
        <TextBlock Text="新标题：" Margin="0,0,0,4"/>
        <TextBox x:Name="TitleBox" Margin="0,0,0,12" Padding="6"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="确定" Click="Ok_Click" IsDefault="True" Padding="16,5" Margin="0,0,8,0"/>
            <Button Content="取消" Click="Cancel_Click" IsCancel="True" Padding="16,5"/>
        </StackPanel>
    </StackPanel>
</Window>
